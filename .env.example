# Copy this file to .env.local (local) or add the same names in Vercel > Settings > Environment Variables.
# NEVER commit real values.

# --- App ---------------------------------------------------------------
# Public URL of the site. Used for email links and the Paystack callback.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------
# Safe for the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used by the Paystack webhook/callback to record payments.
# Never prefix with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (SERVER ONLY) -------------------------------------------
# The ONLY Paystack value needed. Paystack signs webhooks with this same
# secret key, so no separate webhook secret exists.
# Test key starts with sk_test_, live key with sk_live_.
PAYSTACK_SECRET_KEY=
