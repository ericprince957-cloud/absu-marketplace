# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public values, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY, never expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---
# Public key may be used in the browser; the secret key is SERVER ONLY.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Used to verify webhook signatures (Paystack signs with the secret key; keep server-side).
PAYSTACK_WEBHOOK_SECRET=

# --- Membership ---
MEMBERSHIP_FREE_SLOTS=50
MEMBERSHIP_MONTHLY_PRICE_NGN=1500
