# Copy to .env.local for local development.
# Add the same variable names in Vercel Project Settings > Environment Variables.
# Never commit real values.

# Public site URL. No trailing slash.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public project configuration (safe to expose; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used by trusted payment callback/webhook processing.
# Never prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack server-side secret. The app initializes and verifies transactions
# from the server, so no Paystack public key is required by this implementation.
# Start with a test secret (sk_test_...). Switch to a live secret (sk_live_...)
# only after completing the test-mode checklist.
PAYSTACK_SECRET_KEY=

# Optional public contact address shown by the application.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Transactional email for admin account-verification notifications (Resend).
# Use a sender address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
